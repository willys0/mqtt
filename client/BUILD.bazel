load("@rules_cc//cc:defs.bzl", "cc_library", "cc_binary")

cc_library(
    name = "sock",
    srcs = ["sock.cpp"],
    hdrs = ["sock.h"],
    deps = [
        "//mqtt:transport"
    ]
)

cc_binary(
    name = "client",
    srcs = ["client.cpp"],
    deps = [
        "//client:sock",
        "//mqtt:mqtt",
        "//mqtt:transport"
    ],
)
